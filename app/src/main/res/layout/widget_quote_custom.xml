<?xml version="1.0" encoding="utf-8"?>
<!-- 自定义布局：底层液态玻璃 + 文字框 + 最多 4 个图片框，位置/大小由运行时 padding 决定 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/glass_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:visibility="gone"
        android:contentDescription="@null" /><FrameLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/text_wrap"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/text_box"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/text_box_bg"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/text_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/quote_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="知者不惑。"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:shadowColor="#26000000"
                    android:shadowRadius="4"
                    android:shadowDx="0"
                    android:shadowDy="1.5"
                    android:maxLines="8"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/quote_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="— 孔子 · 《论语》 · 原文"
                    android:textColor="@color/accent"
                    android:textSize="11sp"
                    android:shadowColor="#22000000"
                    android:shadowRadius="4"
                    android:shadowDx="0"
                    android:shadowDy="1.5"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/image_wrap1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ImageView
                android:id="@+id/quote_image1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="@null" />

            <AdapterViewFlipper
                android:id="@+id/quote_image_flipper1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoStart="true"
                android:flipInterval="200"
                android:inAnimation="@android:animator/fade_in"
                android:outAnimation="@android:animator/fade_out"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/image_wrap2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ImageView
                android:id="@+id/quote_image2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="@null" />

            <AdapterViewFlipper
                android:id="@+id/quote_image_flipper2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoStart="true"
                android:flipInterval="200"
                android:inAnimation="@android:animator/fade_in"
                android:outAnimation="@android:animator/fade_out"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/image_wrap3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ImageView
                android:id="@+id/quote_image3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="@null" />

            <AdapterViewFlipper
                android:id="@+id/quote_image_flipper3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoStart="true"
                android:flipInterval="200"
                android:inAnimation="@android:animator/fade_in"
                android:outAnimation="@android:animator/fade_out"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/image_wrap4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ImageView
                android:id="@+id/quote_image4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="@null" />

            <AdapterViewFlipper
                android:id="@+id/quote_image_flipper4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoStart="true"
                android:flipInterval="200"
                android:inAnimation="@android:animator/fade_in"
                android:outAnimation="@android:animator/fade_out"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/next_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:text="点按换一句"
            android:textColor="#776F70"
            android:textSize="9sp" />
    </FrameLayout>
</FrameLayout>
