<?xml version="1.0" encoding="utf-8"?>
<!--
  自定义布局的图片槽位：RemoteViews 布局是静态的，只能预先摆好固定数量的槽。
  槽位数必须与 QuoteWidgetProvider.MAX_IMAGE_SLOTS 一致（40）。
  每个槽是 FrameLayout，内含静态 ImageView（GIF 首帧）和 AdapterViewFlipper（逐帧播放）；
  运行时用 padding 把每个槽挤成场景里的矩形。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/glass_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:visibility="gone"
        android:contentDescription="@null" />

    <FrameLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/text_wrap"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/text_box"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/text_box_bg"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/text_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/quote_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="知者不惑。"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:shadowColor="#26000000"
                    android:shadowRadius="4"
                    android:shadowDx="0"
                    android:shadowDy="1.5"
                    android:maxLines="8"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/quote_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="— 孔子 · 《论语》 · 原文"
                    android:textColor="@color/accent"
                    android:textSize="11sp"
                    android:shadowColor="#22000000"
                    android:shadowRadius="4"
                    android:shadowDx="0"
                    android:shadowDy="1.5"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/image_wrap1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ImageView
                android:id="@+id/quote_image1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="@null" />

            <AdapterViewFlipper
                android:id="@+id/quote_image_flipper1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoStart="true"
                android:flipInterval="200"
                android:inAnimation="@android:animator/fade_in"
                android:outAnimation="@android:animator/fade_out"
                android:visibility="gone" />
        </FrameLayout>

