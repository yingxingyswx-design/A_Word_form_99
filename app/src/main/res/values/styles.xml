<resources>
    <!-- Material 3 Expressive：更大的圆角、更醒目的标题、贴壁纸的动态取色 -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>

        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="android:colorBackground">@color/md_surface</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>

        <item name="shapeAppearanceCornerExtraSmall">@style/Shape.Yiyan.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/Shape.Yiyan.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.Yiyan.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.Yiyan.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/Shape.Yiyan.ExtraLarge</item>
    </style>

    <!--
      Material 的 personalized colors 主题覆盖会把 colorPrimary 等改写成它自己的
      material_personalized_color_*；Activity 里再 force 应用这层覆盖，把颜色拉回
      我们通过 ColorResourcesOverride 注入过的 @color/md_*，用户主题色才真正生效。
    -->
    <style name="ThemeOverlay.Yiyan.CustomColors" parent="">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="android:colorBackground">@color/md_surface</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <!-- personalized colors 会把系统文字色改成它自己的 primary_text（深色模式下可能是纯白），
             这里一起拉回 md_*，否则标题 / 段落会出现白字配浅色卡片。 -->
        <item name="android:textColorPrimary">@color/md_on_surface</item>
        <item name="android:textColorPrimaryInverse">@color/md_on_primary</item>
        <item name="android:textColorSecondary">@color/md_on_surface_variant</item>
        <item name="android:textColorSecondaryInverse">@color/md_on_primary</item>
        <item name="android:textColorTertiary">@color/md_on_surface_variant</item>
        <item name="android:textColorTertiaryInverse">@color/md_on_primary</item>
        <item name="android:textColorHint">@color/md_on_surface_variant</item>
        <item name="android:textColorPrimaryDisableOnly">@color/md_on_surface</item>
    </style>

    <style name="Shape.Yiyan.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="Shape.Yiyan.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="Shape.Yiyan.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Shape.Yiyan.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Shape.Yiyan.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">36dp</item>
    </style>

    <!-- 页面标题：Expressive 强调大字号与紧字距 -->
    <style name="TextAppearance.Yiyan.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Yiyan.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 统一按钮形状：胶囊 + 无内缩 -->
    <style name="Widget.Yiyan.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">24dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Yiyan.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">24dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Yiyan.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="contentPadding">20dp</item>
    </style>
</resources>
